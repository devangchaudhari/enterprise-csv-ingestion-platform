{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual_http_request": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "pipeline_id": { "type": "string" },
            "batch_id": { "type": "string" },
            "trigger_type": { "type": "string" },
            "correlation_id": { "type": "string" }
          },
          "required": ["pipeline_id"]
        }
      }
    }
  },
  "actions": {
    "HTTP_Trigger_Local_Adapter": {
      "type": "Http",
      "inputs": {
        "method": "POST",
        "uri": "http://127.0.0.1:8000/api/v1/pipelines/@{triggerBody()?['pipeline_id']}/execute",
        "headers": {
          "X-Correlation-ID": "@{triggerBody()?['correlation_id']}",
          "Content-Type": "application/json"
        },
        "body": {
          "trigger_type": "azure_logic_app"
        }
      },
      "runAfter": {}
    },
    "Check_Run_Status": {
      "type": "If",
      "expression": {
        "and": [
          {
            "equals": [
              "@actionOutputs('HTTP_Trigger_Local_Adapter')['statusCode']",
              200
            ]
          }
        ]
      },
      "actions": {
        "Log_Success_Telemetry": {
          "type": "Response",
          "inputs": {
            "statusCode": 200,
            "body": {
              "status": "COMPLETED",
              "platform": "OmniRetail-DataHub",
              "execution_result": "@body('HTTP_Trigger_Local_Adapter')"
            }
          }
        }
      },
      "else": {
        "actions": {
          "Log_Failure_Incident": {
            "type": "Response",
            "inputs": {
              "statusCode": 500,
              "body": {
                "status": "FAILED",
                "error": "Pipeline execution failed in OmniRetail Data Hub"
              }
            }
          }
        }
      },
      "runAfter": {
        "HTTP_Trigger_Local_Adapter": ["Succeeded", "Failed"]
      }
    }
  },
  "outputs": {}
}
